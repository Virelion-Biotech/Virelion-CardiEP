{
 "$schema":"https://json-schema.org/draft/2020-12/schema",
 "$id":"https://virelionbiotech.org/schemas/ep-disease-context.v1.schema.json",
 "title":"CardiEP provenance-aware disease and genotype context",
 "type":"object",
 "required":["disease_label","genotype_status","variants","source_record_ids","source_provenance","phenotype_label_source_record_ids","phenotype_label_source_provenance","baseline_definition","comparator_definition","uncertainty_reference","calibration_cohort","subject_split","electrotrace_bundle_sha256","requested_mechanisms","inferred_from_ecg"],
 "properties":{
  "disease_label":{"enum":["PKP2_ACM","PLN_cardiomyopathy","BAG3_DCM","LAMP2_Danon","CASQ2_arrhythmia","other","unknown"]},
  "genotype_status":{"enum":["unknown","reported","curated"]},"variants":{"type":"array","items":{"type":"object"}},
  "source_record_ids":{"type":"array","items":{"type":"string"}},"source_provenance":{"type":"array","items":{"type":"object"}},
  "phenotype_label":{"type":["string","null"]},"phenotype_label_source_record_ids":{"type":"array","items":{"type":"string"}},"phenotype_label_source_provenance":{"type":"array","items":{"type":"object"}},
  "baseline_definition":{"type":"object"},"comparator_definition":{"type":"object"},"uncertainty_reference":{"type":"object"},
  "calibration_cohort":{"type":"object"},"subject_split":{"type":"object"},
  "electrotrace_bundle_sha256":{"type":"array","items":{"type":"string","pattern":"^[a-fA-F0-9]{64}$"}},
  "requested_mechanisms":{"type":"array","items":{"enum":["conduction","repolarization","scar_tissue_properties","desmosomal_integrity","intracellular_calcium_cycling","variant_specific_ionic_currents","proteostasis","autophagic_lysosomal_function"]}},
  "parameter_mapping":{"type":["object","null"]},"inferred_from_ecg":{"const":false}
 },
 "additionalProperties":false
}
